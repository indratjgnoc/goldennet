generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum RegistrationStatus {
  PENDING
  SURVEY
  APPROVED
  INSTALLATION
  COMPLETED
  REJECTED
  CANCELLED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  address   String   @db.Text
  phone     String?
  email     String?
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  isActive  Boolean  @default(true)

  customers     Customer[]
  registrations Registration[]
  coverageAreas CoverageArea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

model InternetPackage {
  id          Int     @id @default(autoincrement())
  name        String
  code        String  @unique
  speed       Int
  price       Decimal @db.Decimal(12, 2)
  description String? @db.Text
  isPopular   Boolean @default(false)
  isActive    Boolean @default(true)

  registrations Registration[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("internet_packages")
}

model Customer {
  id           Int            @id @default(autoincrement())
  customerCode String         @unique
  name         String
  phone        String
  email        String?
  address      String         @db.Text
  status       CustomerStatus @default(PROSPECT)

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id])

  registrations Registration[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([email])
  @@index([status])
  @@map("customers")
}

model Registration {
  id               Int                @id @default(autoincrement())
  registrationCode String             @unique
  name             String
  phone            String
  email            String?
  address          String             @db.Text
  notes            String?            @db.Text
  status           RegistrationStatus @default(PENDING)

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])

  packageId Int
  package   InternetPackage @relation(fields: [packageId], references: [id])

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([status])
  @@index([packageId])
  @@index([branchId])
  @@map("registrations")
}

model Subscription {
  id               Int                @id @default(autoincrement())
  subscriptionCode String             @unique
  status           SubscriptionStatus @default(PENDING)
  startDate        DateTime?
  endDate          DateTime?

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  packageId Int
  package   InternetPackage @relation(fields: [packageId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([packageId])
  @@index([status])
  @@map("subscriptions")
}

model CoverageArea {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @db.Text
  isActive    Boolean @default(true)

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Nama area tidak boleh sama dalam satu branch.
  // Contoh:
  // Biaro + GNET-BIARO = boleh
  // Biaro + GNET-BIARO = tidak boleh dua kali
  @@unique([branchId, name])
  @@index([branchId])
  @@map("coverage_areas")
}
