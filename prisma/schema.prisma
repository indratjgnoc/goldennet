generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Branch {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  address       String         @db.Text
  phone         String?
  email         String?
  latitude      Decimal?       @db.Decimal(10, 7)
  longitude     Decimal?       @db.Decimal(10, 7)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  coverageAreas CoverageArea[]
  customers     Customer[]
  registrations Registration[]

  @@map("branches")
}

model InternetPackage {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  speed         Int
  price         Decimal        @db.Decimal(12, 2)
  description   String?        @db.Text
  isPopular     Boolean        @default(false)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]
  subscriptions Subscription[]

  @@map("internet_packages")
}

model Customer {
  id            Int            @id @default(autoincrement())
  customerCode  String         @unique
  name          String
  phone         String
  email         String?
  address       String         @db.Text
  status        CustomerStatus @default(PROSPECT)
  branchId      Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  branch        Branch?        @relation(fields: [branchId], references: [id])
  registrations Registration[]
  subscriptions Subscription[]

  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([branchId], map: "customers_branchId_fkey")
  @@map("customers")
}

model Registration {
  id               Int                @id @default(autoincrement())
  registrationCode String             @unique
  name             String
  phone            String
  email            String?
  address          String             @db.Text
  notes            String?            @db.Text
  status           RegistrationStatus @default(PENDING)
  customerId       Int?
  packageId        Int
  branchId         Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  branch           Branch?            @relation(fields: [branchId], references: [id])
  customer         Customer?          @relation(fields: [customerId], references: [id])
  package          InternetPackage    @relation(fields: [packageId], references: [id])

  @@index([phone])
  @@index([status])
  @@index([packageId])
  @@index([branchId])
  @@index([customerId], map: "registrations_customerId_fkey")
  @@map("registrations")
}

model Subscription {
  id               Int                @id @default(autoincrement())
  subscriptionCode String             @unique
  status           SubscriptionStatus @default(PENDING)
  startDate        DateTime?
  endDate          DateTime?
  customerId       Int
  packageId        Int
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  customer         Customer           @relation(fields: [customerId], references: [id])
  package          InternetPackage    @relation(fields: [packageId], references: [id])

  @@index([customerId])
  @@index([packageId])
  @@index([status])
  @@map("subscriptions")
}

model CoverageArea {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  branchId    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch      Branch   @relation(fields: [branchId], references: [id])

  @@unique([branchId, name])
  @@index([branchId])
  @@map("coverage_areas")
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  username     String     @unique
  email        String?    @unique
  passwordHash String
  role         UserRole   @default(ADMIN)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([role])
  @@index([status])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEKNISI
  CUSTOMER_SERVICE
  FINANCE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum RegistrationStatus {
  PENDING
  SURVEY
  APPROVED
  INSTALLATION
  COMPLETED
  REJECTED
  CANCELLED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}
