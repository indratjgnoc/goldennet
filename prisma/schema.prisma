generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Branch {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  address       String         @db.Text
  phone         String?
  email         String?
  latitude      Decimal?       @db.Decimal(10, 7)
  longitude     Decimal?       @db.Decimal(10, 7)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  coverageAreas CoverageArea[]
  customers     Customer[]
  registrations Registration[]

  @@map("branches")
}

model InternetPackage {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  speed         Int
  price         Decimal        @db.Decimal(12, 2)
  description   String?        @db.Text
  isPopular     Boolean        @default(false)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]
  subscriptions Subscription[]

  @@map("internet_packages")
}

model Customer {
  id            Int            @id @default(autoincrement())
  customerCode  String         @unique
  name          String
  phone         String
  email         String?
  address       String         @db.Text
  status        CustomerStatus @default(PROSPECT)
  branchId      Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  branch        Branch?        @relation(fields: [branchId], references: [id])
  registrations Registration[]
  subscriptions Subscription[]
  installations Installation[]

  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([branchId], map: "customers_branchId_fkey")
  @@map("customers")
}

model Registration {
  id               Int                @id @default(autoincrement())
  registrationCode String             @unique
  name             String
  phone            String
  email            String?
  address          String             @db.Text
  notes            String?            @db.Text
  status           RegistrationStatus @default(PENDING)
  customerId       Int?
  packageId        Int
  branchId         Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  branch           Branch?            @relation(fields: [branchId], references: [id])
  customer         Customer?          @relation(fields: [customerId], references: [id])
  package          InternetPackage    @relation(fields: [packageId], references: [id])

  @@index([phone])
  @@index([status])
  @@index([packageId])
  @@index([branchId])
  @@index([customerId], map: "registrations_customerId_fkey")
  @@map("registrations")
}

model Subscription {
  id               Int                @id @default(autoincrement())
  subscriptionCode String             @unique
  status           SubscriptionStatus @default(PENDING)
  startDate        DateTime?
  endDate          DateTime?
  customerId       Int
  packageId        Int
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  customer         Customer           @relation(fields: [customerId], references: [id])
  package          InternetPackage    @relation(fields: [packageId], references: [id])

  @@index([customerId])
  @@index([packageId])
  @@index([status])
  @@map("subscriptions")
}

model CoverageArea {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  branchId    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch      Branch   @relation(fields: [branchId], references: [id])

  @@unique([branchId, name])
  @@index([branchId])
  @@map("coverage_areas")
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  username     String     @unique
  email        String?    @unique
  passwordHash String
  role         UserRole   @default(ADMIN)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  sessions     Session[]

  stockIns            StockIn[]
  stockOutsIssued     StockOut[]     @relation("StockOutIssuedBy")
  stockOutsTechnician StockOut[]     @relation("StockOutTechnician")
  installations       Installation[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  action      String
  entity      String?
  entityId    String?
  description String?  @db.Text
  ipAddress   String?
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model InventoryCategory {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String?         @db.Text
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       InventoryItem[]

  @@index([isActive])
  @@map("inventory_categories")
}

model InventorySupplier {
  id          Int       @id @default(autoincrement())
  name        String
  code        String    @unique
  phone       String?
  email       String?
  address     String?   @db.Text
  contactName String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  stockIns    StockIn[]

  @@index([name])
  @@index([isActive])
  @@map("inventory_suppliers")
}

model InventoryItem {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  name          String
  description   String?       @db.Text
  categoryId    Int
  unit          InventoryUnit
  stock         Decimal       @default(0) @db.Decimal(12, 2)
  minimumStock  Decimal       @default(0) @db.Decimal(12, 2)
  purchasePrice Decimal       @default(0) @db.Decimal(14, 2)
  location      String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category          InventoryCategory  @relation(fields: [categoryId], references: [id])
  stockInItems      StockInItem[]
  stockOutItems     StockOutItem[]
  installationItems InstallationItem[]

  @@index([categoryId])
  @@index([name])
  @@index([isActive])
  @@map("inventory_items")
}

model StockIn {
  id              Int      @id @default(autoincrement())
  transactionCode String   @unique
  supplierId      Int
  receivedById    Int
  transactionDate DateTime @default(now())
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier   InventorySupplier @relation(fields: [supplierId], references: [id])
  receivedBy User              @relation(fields: [receivedById], references: [id])
  items      StockInItem[]

  @@index([supplierId])
  @@index([receivedById])
  @@index([transactionDate])
  @@map("stock_ins")
}

model StockInItem {
  id        Int     @id @default(autoincrement())
  stockInId Int
  itemId    Int
  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(14, 2)
  subtotal  Decimal @db.Decimal(16, 2)

  stockIn StockIn       @relation(fields: [stockInId], references: [id], onDelete: Cascade)
  item    InventoryItem @relation(fields: [itemId], references: [id])

  @@index([stockInId])
  @@index([itemId])
  @@map("stock_in_items")
}

model StockOut {
  id              Int      @id @default(autoincrement())
  transactionCode String   @unique
  issuedById      Int
  technicianId    Int?
  transactionDate DateTime @default(now())
  purpose         String?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  issuedBy   User           @relation("StockOutIssuedBy", fields: [issuedById], references: [id])
  technician User?          @relation("StockOutTechnician", fields: [technicianId], references: [id])
  items      StockOutItem[]

  @@index([issuedById])
  @@index([technicianId])
  @@index([transactionDate])
  @@map("stock_outs")
}

model StockOutItem {
  id         Int     @id @default(autoincrement())
  stockOutId Int
  itemId     Int
  quantity   Decimal @db.Decimal(12, 2)

  stockOut StockOut      @relation(fields: [stockOutId], references: [id], onDelete: Cascade)
  item     InventoryItem @relation(fields: [itemId], references: [id])

  @@index([stockOutId])
  @@index([itemId])
  @@map("stock_out_items")
}

model Installation {
  id               Int      @id @default(autoincrement())
  installationCode String   @unique
  customerId       Int
  technicianId     Int
  installationDate DateTime @default(now())
  address          String   @db.Text
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer   Customer           @relation(fields: [customerId], references: [id])
  technician User               @relation(fields: [technicianId], references: [id])
  items      InstallationItem[]

  @@index([customerId])
  @@index([technicianId])
  @@index([installationDate])
  @@map("installations")
}

model InstallationItem {
  id             Int     @id @default(autoincrement())
  installationId Int
  itemId         Int
  quantity       Decimal @db.Decimal(12, 2)
  notes          String? @db.Text

  installation Installation  @relation(fields: [installationId], references: [id], onDelete: Cascade)
  item         InventoryItem @relation(fields: [itemId], references: [id])

  @@index([installationId])
  @@index([itemId])
  @@map("installation_items")
}

enum InventoryUnit {
  PCS
  UNIT
  METER
  BOX
  ROLL
  SET
  PACK
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEKNISI
  CUSTOMER_SERVICE
  FINANCE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum RegistrationStatus {
  PENDING
  SURVEY
  APPROVED
  INSTALLATION
  COMPLETED
  REJECTED
  CANCELLED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}
